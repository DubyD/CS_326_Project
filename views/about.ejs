<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/output.css" />
  </head>
  <body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
    <nav class="bg-slate-900 text-slate-100">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
        <a href="/" class="font-semibold tracking-tight">Code → C</a>
        <div class="flex gap-5 text-sm">
          <a href="/" class="text-slate-400 hover:text-white">Converter</a>
          <a href="/about" class="text-white">About</a>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-4xl px-4 py-10">
      <article class="rounded-xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
        <h1 class="text-3xl font-bold tracking-tight text-slate-900"><%= title %></h1>
        <p class="mt-4 leading-relaxed text-slate-600"><%= body %></p>
      </article>
    </main>
  </body>
</html>
