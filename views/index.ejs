<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Code to C Converter</title>
    <link rel="stylesheet" href="/output.css" />
    <script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" defer></script>
    <script src="/app.js" defer></script>
  </head>

  <body class="min-h-screen bg-slate-100 text-slate-800 antialiased">
    <nav class="bg-slate-900 text-slate-100">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-3">
        <a href="/" class="font-semibold tracking-tight">Code → C</a>
        <div class="flex gap-5 text-sm">
          <a href="/" class="text-white">Converter</a>
          <a href="/about" class="text-slate-400 hover:text-white">About</a>
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-4xl space-y-6 px-4 py-10">
      <header>
        <h1 class="text-3xl font-bold tracking-tight text-slate-900">Code to C Converter</h1>
        <p class="mt-2 text-slate-600">
          Select a programming language and enter your code below to convert it
          into C.
        </p>
      </header>

      <section class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <form
          id="converterForm"
          hx-post="/convert"
          hx-target="#result"
          hx-swap="innerHTML"
          class="space-y-5"
        >
          <div>
            <label for="language" class="mb-1 block text-sm font-medium text-slate-700">
              Select Programming Language:
            </label>
            <select
              id="language"
              name="language"
              required
              class="w-full rounded-lg border border-slate-300 bg-white px-3 py-2 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none sm:w-64"
            >
              <option value="C">C (.c)</option>
              <option value="python">Python (.py)</option>
              <option value="javascript">JavaScript (.js)</option>
              <option value="java">Java (.java)</option>
            </select>
          </div>

          <div>
            <label for="sourceCode" class="mb-1 block text-sm font-medium text-slate-700">
              Enter Your Code:
            </label>
            <textarea
              id="sourceCode"
              name="sourceCode"
              rows="12"
              placeholder="Paste your code here..."
              required
              class="w-full rounded-lg border border-slate-300 bg-slate-50 p-3 font-mono text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 focus:outline-none"
            ></textarea>
          </div>

          <button
            type="submit"
            class="cursor-pointer rounded-lg bg-indigo-600 px-5 py-2.5 font-semibold text-white shadow-sm hover:bg-indigo-700 focus:ring-2 focus:ring-indigo-300 focus:outline-none active:bg-indigo-800"
          >
            Convert to C
          </button>
        </form>
      </section>

      <section class="space-y-3">
        <h2 class="text-xl font-semibold text-slate-900">Converted C Code:</h2>
        <pre
          id="result"
          class="min-h-32 overflow-x-auto rounded-xl bg-slate-900 p-5 font-mono text-sm leading-relaxed text-emerald-300 shadow-inner"
        >Your converted code will appear here.</pre>
        <p id="errorMessage" role="alert" class="text-sm font-medium text-red-600 empty:hidden"></p>
      </section>

      <section class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
        <h2 class="text-xl font-semibold text-slate-900">Conversion History</h2>
        <p class="mt-1 mb-4 text-sm text-slate-600">
          Every conversion you run is saved in MongoDB, click to view the saved data.
        </p>
        <ul id="historyList" class="space-y-2"></ul>
      </section>
    </main>
  </body>
</html>
