# copy this file to .env (the real .env is not committed)

# where to find MongoDB
MONGO_URI=mongodb://localhost:27017

# long random string used to sign the session cookie, server.js will not start without it
SESSION_SECRET=replace-me-with-a-long-random-string

# optional, the python used for the compile + decompile step (default: python3)
PYTHON_BIN=/path/to/python3

# optional, how long a conversion may run in milliseconds (default: 30000000)
CONVERT_TIMEOUT_MS=30000000
